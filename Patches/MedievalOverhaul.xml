<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!--Medieval Overhaulを導入して高度な冷暖房が使えない場合に備えて、醸造等の温度設定を無効にする-->
  <Operation Class="PatchOperationFindMod">
    <mods>
        <li>Medieval Overhaul</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="SBK_Hakkoutaru"]/description</xpath>
          <value>
            <description>納豆と味噌を発酵させる樽。</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ProcessorFramework.ProcessDef[defName="NattouHakkou"]/usesTemperature</xpath>
          <value>
            <usesTemperature>false</usesTemperature>
          </value>
        </li>
