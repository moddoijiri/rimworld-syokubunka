  <ThingDef ParentName="SBK_MealBase_Rottable">
    <defName>SBK_Surume</defName>
    <label>するめ</label>
    <description>スルメイカを干した保存食。</description>
    <graphicData>
      <texPath>Things/Item/Meal/Surume</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>12</MarketValue>
      <WorkToMake>350</WorkToMake>
      <Nutrition>0.8</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealSimple</preferability>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <optimalityOffsetFeedingAnimals>-75</optimalityOffsetFeedingAnimals>
    </ingestible>
    <tradeability>None</tradeability>
    <stackLimit>60</stackLimit>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>70</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>
