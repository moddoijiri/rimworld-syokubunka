<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>SBK_Jyouzoutaru</defName>
    <label>醸造樽</label>
    <description>食品を醸造させて酒や醸造調味料を作る樽。適温は酒類：5～15℃、酢：25～35℃、醤油：20～30℃。</description>
    <graphicData>
      <texPath>Things/Building/Jyouzoutaru</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <rect>(0.05,0.1,0.9,0.9)</rect>
      </damageData>
    </graphicData>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <altitudeLayer>Building</altitudeLayer>
    <drawerType>MapMeshAndRealTime</drawerType>
    <passability>PassThroughOnly</passability>
    <canOverlapZones>false</canOverlapZones>
    <fillPercent>0.35</fillPercent>
    <pathCost>60</pathCost>
    <rotatable>true</rotatable>
    <size>(2,2)</size>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>50</costStuffCount>
    <useHitPoints>true</useHitPoints>
    <tickerType>Rare</tickerType>
    <statBases>
      <Cleanliness>-15</Cleanliness>
      <WorkToBuild>600</WorkToBuild>
      <Mass>10</Mass>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>1.0</Flammability>
    </statBases>
    <designationCategory>Production</designationCategory>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="ProcessorFramework.CompProperties_Processor">
        <capacity>40</capacity>
        <independentProcesses>true</independentProcesses>
        <parallelProcesses>true</parallelProcesses>
        <dropIngredients>false</dropIngredients>
        <showProductIcon>true</showProductIcon>
        <barOffset>(0.0, 0.25)</barOffset>
        <barScale>(1.0, 1.0)</barScale>
        <colorCoded>false</colorCoded>
        <processes>
          <li>SakeHakkou</li>
          <li>ImojyouchuuHakkou</li>
          <li>Umesyujyukusei</li>
          <li>YonezuHakkou</li>
          <li>SyouyuHakkou</li>
        </processes>
      </li>
    </comps>
	<researchPrerequisites>
      <li>SBK_SyokuRS</li>
    </researchPrerequisites>
  </ThingDef>
  <!--日本酒発酵-->
  <ProcessorFramework.ProcessDef>
    <defName>SakeHakkou</defName>
    <thingDef>SBK_Sakemasu</thingDef>
    <ingredientFilter>
      <thingDefs>
        <li>SBK_Sakemoromi</li>
      </thingDefs>
    </ingredientFilter>
    <processDays>9</processDays>
    <!-- in days, a day is 60,000 ticks -->
    <capacityFactor>2.0</capacityFactor>
    <efficiency>0.4</efficiency>
    <usesTemperature>true</usesTemperature>
    <temperatureSafe>1.0~25.0</temperatureSafe>
    <temperatureIdeal>6.0~15.0</temperatureIdeal>
    <ruinedPerDegreePerHour>2.5</ruinedPerDegreePerHour>
    <!-- percent per degree per hour -->
    <speedBelowSafe>0.1</speedBelowSafe>
    <speedAboveSafe>1.0</speedAboveSafe>
    <sunFactor>1.0~1.0</sunFactor>
    <rainFactor>1.0~1.0</rainFactor>
    <snowFactor>1.0~1.0</snowFactor>
    <windFactor>1.0~1.0</windFactor>
    <unpoweredFactor>0.0</unpoweredFactor>
    <unfueledFactor>0.0</unfueledFactor>
    <powerUseFactor>1.0</powerUseFactor>
    <fuelUseFactor>1.0</fuelUseFactor>
    <filledGraphicSuffix>
    </filledGraphicSuffix>
    <usesQuality>false</usesQuality>
    <qualityDays>(1, 2, 3, 4, 5, 6, 7)</qualityDays>
    <color>(255, 255, 255)</color>
    <!-- 0-255 or 0.0-1.0 -->
    <customLabel>
    </customLabel>
    <destroyChance>0.0</destroyChance>
  </ProcessorFramework.ProcessDef>
