<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  
  <!--果物-->

  <ThingDef ParentName="SBK_FruitTree">
    <defName>Plant_TreeUme</defName>
    <label>梅の木</label>
    <description>梅の木説明</description>
    <graphicData>
      <texPath>Things/Plant/Ume</texPath>
      <graphicClass>Graphic_Random</graphicClass>
        <shadowData>
          <volume>(0.15, 0.3, 0.15)</volume>
          <offset>(0,0,-0.38)</offset>
        </shadowData>
    </graphicData>
    <selectable>true</selectable>
    <statBases>
      <Beauty>2</Beauty>
      <BeautyOutdoors>2</BeautyOutdoors>
      <Nutrition>1.5</Nutrition>
    </statBases>
    <minifiedDef IsNull="True" />
    <ingestible />
    <plant>
      <growDays>25</growDays>
      <visualSizeRange>1~2.5</visualSizeRange>
      
      <topWindExposure>0.15</topWindExposure>
      <harvestWork>350</harvestWork>
      <harvestTag>Standard</harvestTag>
      <forceIsTree>true</forceIsTree>
      <harvestYield>20</harvestYield>
      <harvestedThingDef>SBK_RawUme</harvestedThingDef>
    </plant>
  </ThingDef>
  
