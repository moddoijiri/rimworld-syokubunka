<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--穀類-->

  <ThingDef ParentName="SBK_YasaiPlant">
    <defName>SBK_PlantKomugi</defName>
    <label>小麦</label>
    <description>小麦植物説明</description>
    <graphicData>
      <texPath>Things/Plant/Komugi</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <pathCost>14</pathCost>
    <plant>
      <maxMeshCount>4</maxMeshCount>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>SBK_RawKomugi</harvestedThingDef>
      <harvestYield>6</harvestYield>
      <topWindExposure>0.1</topWindExposure>
      <growDays>6.3</growDays>
      <visualSizeRange>0.5~0.8</visualSizeRange>
      <wildOrder>2</wildOrder>
      <purpose>Food</purpose>
      <humanFoodPlant>true</humanFoodPlant>
    </plant>
  </ThingDef>
  
