<Defs>


    <RecipeDef ParentName="CookMotoBase">
    <defName>Make_moromi</defName>
    <label>もろみ(酒)を作る</label>
    <description>蒸し米、麹、酒母、水を混ぜ合わせてもろみ(酒)を作る。</description>
    <jobString>もろみ(酒)を作っている</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>SBK_RawUruchimai</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
		<filter>
		  <thingDefs>
		    <li>SBK_Komekouji</li>
		  </thingDefs>
		</filter>
		<count>3</count>
      </li>
	  <li>
		<filter>
		  <thingDefs>
		    <li>SBK_Mamizu</li>
		  </thingDefs>
		</filter>
		<count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>SBK_RawUruchimai</li>
        <li>SBK_Komekouji</li>
		<li>SBK_Mamizu</li>
      </thingDefs>
    </fixedIngredientFilter>
        <products>
			<SBK_Sakemoromi>40</SBK_Sakemoromi>
		</products>
  </RecipeDef>
  
