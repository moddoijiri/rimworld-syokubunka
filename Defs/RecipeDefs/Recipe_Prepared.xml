<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<RecipeDef ParentName="PrepareSuisanBase">
    <defName>PreppUnagi</defName>
    <label>鰻を捌く</label>
    <description>鰻を捌いて開きにする</description>
    <jobString>鰻を捌いている</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <allowMixingIngredients>true</allowMixingIngredients>
    <workAmount>1000</workAmount>
    <!-- 材料 -->
   <ingredients>
	  <li>
        <filter>
          <thingDefs>
            <li>SBK_Unagi</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      
   </ingredients>
                <!-- 使える素材 -->
		<fixedIngredientFilter>
		   	<thingDefs>
			    <li>SBK_Unagi</li>
			</thingDefs>
		</fixedIngredientFilter>
                <!-- 完成品 -->
		<products>
			<SBK_UnagiHiraki>4</SBK_UnagiHiraki>
		</products>
    <workSkill>Cooking</workSkill>
    
  </RecipeDef>
  
